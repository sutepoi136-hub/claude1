# Copy this file to ".env" and put your Anthropic API key after ANTHROPIC_API_KEY=
# Example:  ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx...   (use only half-width letters and digits, no spaces, no quotes needed)
# Leave it empty to play without AI scoring.
ANTHROPIC_API_KEY=

# Optional
# PORT=8000
# PMO_AI_MODEL=claude-opus-5-5
